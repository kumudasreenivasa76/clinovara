# Copy this file to .env and fill in your key to switch the AI front desk, the virtual assistant for
# calls, and marketing draft generation from the built-in rule engine over to Claude.
# Nothing else needs to change: every AI-touching feature already checks for this key at request time
# (domain/frontDesk.js, domain/assistant.js which reuses it, and domain/marketing.js) and falls back to
# the rule engine automatically if a call to Claude fails, so it's always safe to set.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: force the engine instead of relying on ANTHROPIC_API_KEY being present.
#   CLINOVARA_AI=claude   always use Claude (still needs a key or ANTHROPIC_AUTH_TOKEN above)
#   CLINOVARA_AI=rules    always use the rule engine, even if a key is set (used by the test suite)
# CLINOVARA_AI=

# Optional: where clinic data is written to disk. Defaults to backend/data.
# CLINOVARA_DATA_DIR=

# Optional: base URL the backend uses when it builds links (forms, calendar) into messages it sends.
# Defaults to http://localhost:5190/ in development.
# CLINOVARA_FRONTEND_URL=
